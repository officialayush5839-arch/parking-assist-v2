# KPIT Parking Assist V2.0 — optional environment overrides.
# Copy to .env and edit, or export in your shell.  All values are optional;
# configuration files under config/ provide the defaults.

# System
KPA_MODE=simulation            # simulation | camera | hardware | demo | selftest
KPA_LOOP_HZ=15                 # target pipeline rate
KPA_VERBOSE=0                  # 1 for verbose/debug telemetry
KPA_DURATION=0                 # seconds to run (0 = run forever / scenario default)
KPA_SCENARIO=vehicle_approaching_fast

# Logging
KPA_LOG_LEVEL=INFO
KPA_LOG_DIR=logs

# Dashboard
KPA_DASHBOARD=0                # 1 to auto-start the web dashboard with the app
KPA_DASHBOARD_PORT=8765